# HTTP server
PORT=4000
# Keep 127.0.0.1 when serving behind nginx/reverse proxy.
HOST=127.0.0.1

# Optional on-chain listener. Leave empty to disable it.
RPC_URL=

# Optional comma-separated browser origins for cross-origin development.
# Production deployments should normally leave this empty and use same-origin serving.
CORS_ORIGINS=http://localhost:4173

# Optional SSE limits
SSE_MAX_CONNECTIONS_PER_IP=4
SSE_OPEN_WINDOW_MS=60000
SSE_MAX_OPENS_PER_WINDOW=20
