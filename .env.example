# HTTP server
PORT=4000
# Keep 127.0.0.1 when serving behind nginx/reverse proxy.
HOST=127.0.0.1

# External API/RPC request timeout in milliseconds.
EXTERNAL_FETCH_TIMEOUT_MS=10000
RPC_TIMEOUT_MS=10000

# Optional admin-only diagnostics. Keep disabled in public deployments.
ENABLE_DEBUG_ENDPOINT=false
ADMIN_API_TOKEN=

# Public API rate limits.
REST_RATE_LIMIT_WINDOW_MS=60000
REST_RATE_LIMIT_MAX=120
INVENTORY_RATE_LIMIT_WINDOW_MS=60000
INVENTORY_RATE_LIMIT_MAX=20

# Optional item database path.
ITEMS_PATH=/home/ubuntu/ftk-bot/data/items.json

# Optional on-chain listener. Leave empty to disable it.
RPC_URL=

# Optional comma-separated browser origins for cross-origin development.
# Production deployments should normally leave this empty and use same-origin serving.
CORS_ORIGINS=http://localhost:4173

# Optional SSE limits
SSE_MAX_CONNECTIONS_PER_IP=4
SSE_OPEN_WINDOW_MS=60000
SSE_MAX_OPENS_PER_WINDOW=20
